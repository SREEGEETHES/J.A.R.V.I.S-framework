# JARVIS-FRAMEWORK .gitignore

# ── State history archives ─────────────────────────────────────────────────────
# Previous STATE.md runs are archived here — keep out of version control
# if you want a clean ledger per install. Remove this line to track history.
.jarvis/history/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.secret
secrets.json
credentials.json
serviceAccountKey.json

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Node / JavaScript ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
.cache/
*.min.js
*.min.css

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log
yarn-debug.log

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/

# ── Lock files (keep package-lock.json / yarn.lock, ignore others) ────────────
.yarn/cache
.pnp.*
